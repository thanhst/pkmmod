<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/img_login_icon"
            android:layout_width="@dimen/dp_z_100"
            android:layout_height="@dimen/dp_z_100"
            android:layout_marginTop="@dimen/dp_z_28"
            android:src="@drawable/cg_login_reg"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="@dimen/sp_z_30"
            android:textColor="@color/cg_color_blue3"
            android:id="@+id/txt_login_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_z_6"
            android:text="@string/txt_login_register"/>
    </LinearLayout>
</LinearLayout>
