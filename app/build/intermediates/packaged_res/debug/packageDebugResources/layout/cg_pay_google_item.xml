<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="bottom|center_horizontal"
        android:paddingLeft="@dimen/dp_z_20"
        android:paddingRight="@dimen/dp_z_20"
        android:paddingBottom="@dimen/dp_z_10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_z_100">
        <RelativeLayout
            android:background="@drawable/cg_img_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_z_80">
            <TextView
                android:textSize="@dimen/sp_z_30"
                android:textColor="@color/cg_color_dag"
                android:gravity="center_vertical"
                android:id="@+id/txt_name"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_z_80"
                android:layout_marginLeft="@dimen/dp_z_36"
                android:text="卡支付"/>
            <ImageView
                android:id="@+id/img_btn"
                android:background="@drawable/cg_btn"
                android:layout_width="@dimen/dp_z_186"
                android:layout_height="@dimen/dp_z_58"
                android:layout_marginRight="@dimen/dp_z_32"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp_z_35"
                android:textColor="@color/cg_color_white"
                android:gravity="center"
                android:layout_width="@dimen/dp_z_186"
                android:layout_height="@dimen/dp_z_58"
                android:layout_marginRight="@dimen/dp_z_32"
                android:text="@string/txt_pay"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
