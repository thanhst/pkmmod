<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="@dimen/dp_z_848"
        android:layout_height="@dimen/dp_z_100"
        android:layout_marginTop="@dimen/dp_z_112">
        <EditText
            android:textSize="@dimen/sp_z_35"
            android:textColor="@color/cg_color_dag"
            android:textColorHint="@color/cg_color_hint"
            android:id="@+id/edit_input_old_psw"
            android:background="@drawable/cg_edit_selector"
            android:paddingLeft="@dimen/dp_z_124"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_z_100"
            android:hint="@string/txt_input_old_psw"
            android:singleLine="true"
            android:maxLength="50"
            android:inputType="textPassword"
            android:imeOptions="flagNoExtractUi"/>
        <ImageView
            android:layout_width="@dimen/dp_z_100"
            android:layout_height="@dimen/dp_z_100"
            android:src="@drawable/cg_img_account_blue"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="@dimen/dp_z_848"
        android:layout_height="@dimen/dp_z_100"
        android:layout_marginTop="@dimen/dp_z_38">
        <EditText
            android:textSize="@dimen/sp_z_35"
            android:textColor="@color/cg_color_dag"
            android:textColorHint="@color/cg_color_hint"
            android:id="@+id/edit_input_new_psw"
            android:background="@drawable/cg_edit_selector"
            android:paddingLeft="@dimen/dp_z_124"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_z_100"
            android:hint="@string/txt_input_new_psw"
            android:singleLine="true"
            android:maxLength="50"
            android:inputType="textPassword"
            android:imeOptions="flagNoExtractUi"/>
        <ImageView
            android:layout_width="@dimen/dp_z_100"
            android:layout_height="@dimen/dp_z_100"
            android:src="@drawable/cg_img_psw_blue"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="@dimen/dp_z_848"
        android:layout_height="@dimen/dp_z_100"
        android:layout_marginTop="@dimen/dp_z_38">
        <EditText
            android:textSize="@dimen/sp_z_35"
            android:textColor="@color/cg_color_dag"
            android:textColorHint="@color/cg_color_hint"
            android:id="@+id/edit_reinput_new_psw"
            android:background="@drawable/cg_edit_selector"
            android:paddingLeft="@dimen/dp_z_124"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_z_100"
            android:hint="@string/txt_input_new_psw_again"
            android:singleLine="true"
            android:maxLength="50"
            android:inputType="textPassword"
            android:imeOptions="flagNoExtractUi"/>
        <ImageView
            android:layout_width="@dimen/dp_z_100"
            android:layout_height="@dimen/dp_z_100"
            android:src="@drawable/cg_img_psw_blue"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <Button
        android:textSize="@dimen/sp_z_35"
        android:textStyle="bold"
        android:textColor="@color/cg_color_white"
        android:id="@+id/btn_confirm_change"
        android:background="@drawable/cg_btn5"
        android:layout_width="@dimen/dp_z_848"
        android:layout_height="@dimen/dp_z_100"
        android:layout_marginTop="@dimen/dp_z_68"
        android:text="@string/txt_confirm"/>
</LinearLayout>
