<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/nd_gcsdk_box_tit_bg"
        android:layout_width="310dp"
        android:layout_height="48dp">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/cg_color_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/txt_title"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawablePadding="5dp"
            android:layout_weight="1"/>
        <View
            android:background="@drawable/cg_sdk_box_bg"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"/>
        <ImageButton
            android:id="@+id/imgbtn_close"
            android:background="#00000000"
            android:padding="3dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/cg_close"/>
    </LinearLayout>
    <WebView
        android:id="@+id/web_ad"
        android:background="#0c64ab"
        android:padding="2dp"
        android:layout_width="310dp"
        android:layout_height="150dp"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/cg_color_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/txt_summary"
        android:background="@drawable/cg_sdk_box_bg"
        android:paddingLeft="14sp"
        android:paddingRight="14sp"
        android:layout_width="310dp"
        android:layout_height="45dp"
        android:text="@string/txt_ad_exit"
        android:singleLine="true"/>
</LinearLayout>
