<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/legacy_web_layout"
        android:layout_width="@dimen/dp_z_1850"
        android:layout_height="@dimen/dp_z_970">
        <include layout="@layout/cg_background_all"/>
        <WebView
            android:id="@+id/cg_webview"
            android:layout_width="@dimen/dp_z_1780"
            android:layout_height="@dimen/dp_z_770"
            android:layout_marginTop="@dimen/dp_z_160"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <WebView
        android:id="@+id/fullscreen_web"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
