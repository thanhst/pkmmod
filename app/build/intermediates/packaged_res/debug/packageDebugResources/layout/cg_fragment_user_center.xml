<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_z_150"
        android:layout_marginLeft="@dimen/dp_z_46"
        android:layout_marginTop="@dimen/dp_z_40"
        android:layout_marginRight="@dimen/dp_z_46">
        <ImageView
            android:id="@+id/cg_iv_head"
            android:layout_width="@dimen/dp_z_150"
            android:layout_height="@dimen/dp_z_150"
            android:src="@drawable/head_img"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_z_26"
            android:layout_toRightOf="@+id/cg_iv_head"
            android:layout_centerVertical="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_z_40"
                    android:textColor="@color/cg_color_gray2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_account_name"/>
                <TextView
                    android:textSize="@dimen/sp_z_40"
                    android:textColor="@color/cg_color_gray2"
                    android:id="@+id/txt_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_z_6"
                    android:text="644421231233"/>
                <Button
                    android:textSize="@dimen/sp_z_26"
                    android:textColor="@color/cg_color_gray3"
                    android:id="@+id/btn_copy_acc"
                    android:background="@drawable/cg_btn_bg_light_gray2"
                    android:layout_width="@dimen/dp_z_180"
                    android:layout_height="@dimen/dp_z_36"
                    android:layout_marginLeft="@dimen/dp_z_16"
                    android:text="@string/txt_copy_acc_msg"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_z_20">
                <TextView
                    android:textSize="@dimen/sp_z_34"
                    android:textColor="@color/cg_color_gray3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_device_num"/>
                <TextView
                    android:textSize="@dimen/sp_z_34"
                    android:textColor="@color/cg_color_gray3"
                    android:id="@+id/txt_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_z_6"
                    android:text="644421231233"/>
                <Button
                    android:textSize="@dimen/sp_z_26"
                    android:textColor="@color/cg_color_gray3"
                    android:id="@+id/btn_copy"
                    android:background="@drawable/cg_btn_bg_light_gray2"
                    android:layout_width="@dimen/dp_z_120"
                    android:layout_height="@dimen/dp_z_36"
                    android:layout_marginLeft="@dimen/dp_z_16"
                    android:text="@string/txt_copy"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <Button
                android:textSize="@dimen/sp_z_26"
                android:textColor="@color/cg_color_dag"
                android:id="@+id/btn_visitor_switch"
                android:background="@drawable/cg_btn_bg_light_gray1"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="@dimen/dp_z_280"
                android:layout_height="@dimen/dp_z_60"
                android:layout_marginBottom="@dimen/dp_z_18"
                android:text="@string/txt_switch_account"/>
            <Button
                android:textSize="@dimen/sp_z_26"
                android:textColor="@color/cg_color_blue"
                android:id="@+id/btn_check_charge"
                android:background="@drawable/cg_btn_bg_light_blue2"
                android:focusable="true"
                android:layout_width="@dimen/dp_z_280"
                android:layout_height="@dimen/dp_z_60"
                android:text="@string/txt_check_charge"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_positive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_change_psw"
            android:background="@color/cg_trancelucent"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_z_40">
            <RelativeLayout
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_z_40">
                <ImageView
                    android:id="@+id/change_psw_img"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/dp_z_54"
                    android:layout_height="@dimen/dp_z_54"
                    android:layout_marginLeft="@dimen/dp_z_50"
                    android:src="@drawable/cg_change_psw"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/sp_z_40"
                    android:textColor="@color/cg_color_light_blue"
                    android:id="@+id/txt_change_psw_title"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_z_42"
                    android:text="@string/txt_change_psw"
                    android:layout_toRightOf="@+id/change_psw_img"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/dp_z_22"
                    android:layout_height="@dimen/dp_z_22"
                    android:layout_marginRight="@dimen/dp_z_66"
                    android:src="@drawable/cg_arrow_right"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:background="@color/cg_color_light_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_4"
                android:layout_marginTop="@dimen/dp_z_40"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_safe_set"
            android:background="@color/cg_trancelucent"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_z_40">
                <ImageView
                    android:id="@+id/safe_set_img"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/dp_z_54"
                    android:layout_height="@dimen/dp_z_54"
                    android:layout_marginLeft="@dimen/dp_z_50"
                    android:src="@drawable/cg_safe_set"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/sp_z_40"
                    android:textColor="@color/cg_color_light_blue"
                    android:gravity="center_vertical"
                    android:id="@+id/safe_set_title_tv"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_z_42"
                    android:text="@string/txt_safe_set"
                    android:layout_toRightOf="@+id/safe_set_img"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/safe_set_arrow_right"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/dp_z_22"
                    android:layout_height="@dimen/dp_z_22"
                    android:layout_marginRight="@dimen/dp_z_66"
                    android:src="@drawable/cg_arrow_right"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/sp_z_40"
                    android:textColor="@color/cg_color_red"
                    android:gravity="center_vertical"
                    android:id="@+id/txt_warn"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_z_30"
                    android:text="@string/txt_warning_safe"
                    android:layout_toLeftOf="@+id/safe_set_arrow_right"/>
            </RelativeLayout>
            <View
                android:background="@color/cg_color_light_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_4"
                android:layout_marginTop="@dimen/dp_z_40"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_cancel_account"
            android:background="@color/cg_trancelucent"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_z_40">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/cancel_account_img"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/dp_z_54"
                    android:layout_height="@dimen/dp_z_54"
                    android:layout_marginLeft="@dimen/dp_z_50"
                    android:src="@drawable/cg_cancel_account"
                    android:scaleType="fitCenter"
                    android:tint="@color/cg_color_light_blue"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/sp_z_40"
                    android:textColor="@color/cg_color_light_blue"
                    android:gravity="center_vertical"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_z_42"
                    android:text="@string/txt_cancel_account"
                    android:layout_toRightOf="@+id/cancel_account_img"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/dp_z_22"
                    android:layout_height="@dimen/dp_z_22"
                    android:layout_marginRight="@dimen/dp_z_66"
                    android:src="@drawable/cg_arrow_right"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:background="@color/cg_color_light_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_4"
                android:layout_marginTop="@dimen/dp_z_40"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_switch_account"
            android:background="@color/cg_trancelucent"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_z_40">
                <ImageView
                    android:id="@+id/switch_account_img"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/dp_z_54"
                    android:layout_height="@dimen/dp_z_54"
                    android:layout_marginLeft="@dimen/dp_z_50"
                    android:src="@drawable/cg_switch_account"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/sp_z_40"
                    android:textColor="@color/cg_color_light_blue"
                    android:gravity="center_vertical"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_z_42"
                    android:text="@string/txt_switch_account"
                    android:layout_toRightOf="@+id/switch_account_img"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/dp_z_22"
                    android:layout_height="@dimen/dp_z_22"
                    android:layout_marginRight="@dimen/dp_z_66"
                    android:src="@drawable/cg_arrow_right"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:background="@color/cg_color_light_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_4"
                android:layout_marginTop="@dimen/dp_z_40"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layout_visitor"
        android:visibility="gone"
        android:layout_width="@dimen/dp_z_1300"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_z_36"
            android:textColor="@color/cg_color_light_red"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_z_10"
            android:text="@string/txt_visitor_tips"/>
        <RelativeLayout
            android:background="@drawable/cg_bg_back4"
            android:padding="@dimen/dp_z_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_z_364"
            android:layout_marginTop="@dimen/dp_z_10">
            <com.sfyvctwaqbjhki.uwmpqfh.lebktch.EditTextWithDel
                android:textSize="@dimen/sp_z_30"
                android:textColor="@color/cg_color_dag"
                android:textColorHint="@color/cg_color_hint"
                android:id="@+id/edit_update_acc"
                android:background="@drawable/edit_normal"
                android:paddingLeft="@dimen/dp_z_156"
                android:paddingRight="@dimen/dp_z_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_120"
                android:hint="@string/txt_hint_account"
                android:singleLine="true"
                android:imeOptions="flagNoExtractUi"/>
            <ImageView
                android:background="@drawable/cg_uhead"
                android:layout_width="@dimen/dp_z_50"
                android:layout_height="@dimen/dp_z_50"
                android:layout_marginLeft="@dimen/dp_z_30"
                android:layout_marginTop="@dimen/dp_z_34"/>
            <View
                android:background="@color/cg_color_grary"
                android:layout_width="@dimen/dp_z_2"
                android:layout_height="@dimen/dp_z_20"
                android:layout_marginLeft="@dimen/dp_z_128"
                android:layout_marginTop="@dimen/dp_z_50"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_line"
                android:background="@color/cg_color_grary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_2"
                android:layout_below="@+id/edit_update_acc"/>
            <com.sfyvctwaqbjhki.uwmpqfh.lebktch.EditTextWithDel
                android:textSize="@dimen/sp_z_30"
                android:textColor="@color/cg_color_dag"
                android:textColorHint="@color/cg_color_hint"
                android:id="@+id/edit_update_pwd"
                android:background="@drawable/edit_normal"
                android:paddingLeft="@dimen/dp_z_156"
                android:paddingRight="@dimen/dp_z_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_120"
                android:layout_marginTop="@dimen/dp_z_122"
                android:hint="@string/txt_input_new_psw"
                android:password="true"
                android:singleLine="true"
                android:imeOptions="flagNoExtractUi"/>
            <ImageView
                android:background="@drawable/cg_login_pwd"
                android:layout_width="@dimen/dp_z_50"
                android:layout_height="@dimen/dp_z_50"
                android:layout_marginLeft="@dimen/dp_z_30"
                android:layout_marginTop="@dimen/dp_z_158"/>
            <View
                android:background="@color/cg_color_grary"
                android:layout_width="@dimen/dp_z_2"
                android:layout_height="@dimen/dp_z_20"
                android:layout_marginLeft="@dimen/dp_z_128"
                android:layout_marginTop="@dimen/dp_z_172"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/cg_color_grary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_2"
                android:layout_below="@+id/edit_update_pwd"/>
            <com.sfyvctwaqbjhki.uwmpqfh.lebktch.EditTextWithDel
                android:textSize="@dimen/sp_z_30"
                android:textColor="@color/cg_color_dag"
                android:textColorHint="@color/cg_color_hint"
                android:id="@+id/edit_update_confirm"
                android:background="@drawable/edit_normal"
                android:paddingLeft="@dimen/dp_z_156"
                android:paddingRight="@dimen/dp_z_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_120"
                android:layout_marginTop="@dimen/dp_z_244"
                android:hint="@string/txt_input_new_psw_again"
                android:password="true"
                android:singleLine="true"
                android:imeOptions="flagNoExtractUi"/>
            <ImageView
                android:background="@drawable/cg_login_pwd"
                android:layout_width="@dimen/dp_z_50"
                android:layout_height="@dimen/dp_z_50"
                android:layout_marginLeft="@dimen/dp_z_30"
                android:layout_marginTop="@dimen/dp_z_280"/>
            <View
                android:background="@color/cg_color_grary"
                android:layout_width="@dimen/dp_z_2"
                android:layout_height="@dimen/dp_z_20"
                android:layout_marginLeft="@dimen/dp_z_128"
                android:layout_marginTop="@dimen/dp_z_292"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="@dimen/sp_z_40"
                android:textColor="@color/cg_color_white"
                android:id="@+id/btn_cancel_account"
                android:background="@drawable/cg_btn_get_verify"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_100"
                android:layout_marginTop="@dimen/dp_z_20"
                android:layout_marginRight="@dimen/dp_z_10"
                android:text="@string/txt_cancel_account"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/sp_z_40"
                android:textColor="@color/cg_color_white"
                android:id="@+id/btn_update"
                android:background="@drawable/cg_btn5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_100"
                android:layout_marginTop="@dimen/dp_z_20"
                android:text="@string/float_button_bind_account"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
