<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_bg"
        android:layout_width="@dimen/dp_z_978"
        android:layout_height="@dimen/dp_z_760"
        android:layout_centerInParent="true">
        <include layout="@layout/cg_background_all1"/>
        <Button
            android:textSize="@dimen/sp_z_44"
            android:textColor="@color/cg_color_white"
            android:id="@+id/btn_login"
            android:background="@drawable/cg_btn5"
            android:layout_width="@dimen/dp_z_910"
            android:layout_height="@dimen/dp_z_104"
            android:layout_marginTop="@dimen/dp_z_452"
            android:text="@string/txt_login_game"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="@dimen/sp_z_36"
            android:textColor="@color/cg_color_dark_blue"
            android:id="@+id/txt_change_login"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_z_40"
            android:layout_marginTop="@dimen/dp_z_630"
            android:text="@string/txt_change_login"
            android:layout_alignParentLeft="true"/>
        <Button
            android:textSize="@dimen/dp_z_36"
            android:textColor="@color/cg_color_dark_blue"
            android:id="@+id/btn_register"
            android:background="@drawable/cg_shape_rec_edge_dark_blue"
            android:layout_width="@dimen/dp_z_302"
            android:layout_height="@dimen/dp_z_92"
            android:layout_marginTop="@dimen/dp_z_606"
            android:layout_marginRight="@dimen/dp_z_40"
            android:text="@string/txt_register_formal"
            android:layout_alignParentRight="true"/>
        <RelativeLayout
            android:id="@+id/layout_select"
            android:background="@drawable/cg_bg_back4"
            android:padding="@dimen/dp_z_2"
            android:layout_width="@dimen/dp_z_910"
            android:layout_height="@dimen/dp_z_232"
            android:layout_marginTop="@dimen/dp_z_174"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <EditText
                android:textSize="@dimen/sp_z_35"
                android:textColor="@color/cg_color_black"
                android:textColorHint="@color/cg_color_hint"
                android:gravity="center_vertical"
                android:id="@+id/txt_account"
                android:background="@drawable/edit_normal"
                android:paddingLeft="@dimen/dp_z_156"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_116"
                android:hint="@string/txt_hint_account"
                android:singleLine="true"
                android:maxLength="50"
                android:imeOptions="flagNoExtractUi"/>
            <ImageView
                android:background="@drawable/cg_uhead"
                android:layout_width="@dimen/dp_z_50"
                android:layout_height="@dimen/dp_z_50"
                android:layout_marginLeft="@dimen/dp_z_30"
                android:layout_marginTop="@dimen/dp_z_34"/>
            <View
                android:background="@color/cg_color_grary"
                android:layout_width="@dimen/dp_z_2"
                android:layout_height="@dimen/dp_z_20"
                android:layout_marginLeft="@dimen/dp_z_128"
                android:layout_marginTop="@dimen/dp_z_50"/>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/layout_acc_select"
                android:layout_width="@dimen/dp_z_120"
                android:layout_height="@dimen/dp_z_120"
                android:layout_alignParentRight="true">
                <ImageView
                    android:background="@drawable/cg_login_select_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_line"
                android:background="@color/cg_color_grary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_2"
                android:layout_below="@+id/txt_account"/>
            <EditText
                android:textSize="@dimen/sp_z_35"
                android:textColor="@color/cg_color_black"
                android:textColorHint="@color/cg_color_hint"
                android:gravity="center_vertical"
                android:id="@+id/txt_password"
                android:background="@drawable/edit_normal"
                android:paddingLeft="@dimen/dp_z_156"
                android:paddingRight="@dimen/dp_z_280"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_z_116"
                android:hint="@string/txt_hint_password"
                android:password="true"
                android:singleLine="true"
                android:layout_below="@+id/layout_line"
                android:imeOptions="flagNoExtractUi"/>
            <ImageView
                android:background="@drawable/cg_login_pwd"
                android:layout_width="@dimen/dp_z_50"
                android:layout_height="@dimen/dp_z_50"
                android:layout_marginLeft="@dimen/dp_z_30"
                android:layout_marginTop="@dimen/dp_z_150"/>
            <TextView
                android:textSize="@dimen/sp_z_35"
                android:textColor="@color/cg_color_dag"
                android:gravity="center"
                android:id="@+id/txt_fogret_pwd"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_z_116"
                android:layout_marginRight="@dimen/dp_z_30"
                android:text="@string/txt_forget_password"
                android:layout_below="@+id/layout_line"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/img_clear_pwd"
                android:visibility="gone"
                android:layout_width="@dimen/dp_z_116"
                android:layout_height="@dimen/dp_z_116"
                android:layout_marginTop="@dimen/dp_z_116"
                android:layout_marginRight="@dimen/dp_z_0"
                android:src="@drawable/cg_img_close"
                android:scaleType="centerInside"
                android:layout_toLeftOf="@+id/txt_fogret_pwd"/>
            <View
                android:background="@color/cg_color_grary"
                android:layout_width="@dimen/dp_z_2"
                android:layout_height="@dimen/dp_z_20"
                android:layout_marginLeft="@dimen/dp_z_128"
                android:layout_marginTop="@dimen/dp_z_164"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layout_select_list_layout"
            android:layout_width="@dimen/dp_z_910"
            android:layout_height="@dimen/dp_z_350"
            android:layout_marginTop="@dimen/dp_z_292"
            android:layout_centerHorizontal="true">
            <com.sfyvctwaqbjhki.uwmpqfh.qnaumypvbsxtz.SmMyRuq
                android:id="@+id/layout_select_list"
                android:background="@drawable/cg_bg_back4"
                android:layout_width="@dimen/dp_z_910"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <ListView
                    android:id="@+id/list_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cacheColorHint="@android:color/transparent"
                    android:divider="@color/cg_color_grary"
                    android:dividerHeight="@dimen/dp_z_2"/>
            </com.sfyvctwaqbjhki.uwmpqfh.qnaumypvbsxtz.SmMyRuq>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
