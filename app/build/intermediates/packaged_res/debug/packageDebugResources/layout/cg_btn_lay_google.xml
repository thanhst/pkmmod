<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cg_shape_btn_red"
    android:layout_width="@dimen/dp_z_820"
    android:layout_height="@dimen/dp_z_124">
    <ImageView
        android:id="@+id/img_main_icon"
        android:layout_width="@dimen/dp_z_56"
        android:layout_height="@dimen/dp_z_56"
        android:layout_marginLeft="@dimen/dp_z_106"
        android:src="@drawable/cg_icon_google_logo"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/virtial_line"
        android:background="@color/cg_color_white"
        android:layout_width="@dimen/dp_z_4"
        android:layout_height="@dimen/dp_z_50"
        android:layout_marginLeft="@dimen/dp_z_92"
        android:layout_toRightOf="@+id/img_main_icon"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/sp_z_40"
        android:textColor="@color/cg_color_white"
        android:id="@+id/txt_main_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_z_122"
        android:text="@string/txt_google_login"
        android:layout_toRightOf="@+id/virtial_line"
        android:layout_centerVertical="true"/>
</RelativeLayout>
