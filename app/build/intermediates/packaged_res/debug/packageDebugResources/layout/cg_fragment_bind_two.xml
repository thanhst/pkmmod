<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/cg_trancelucent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_z_36"
        android:textColor="@color/cg_color_dag"
        android:layout_width="@dimen/dp_z_838"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_z_100"
        android:text="@string/txt_bind_warn"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_input_psw"
        android:background="@drawable/cg_shape_rec_edge_dark_blue2"
        android:layout_width="@dimen/dp_z_836"
        android:layout_height="@dimen/dp_z_110"
        android:layout_marginTop="@dimen/dp_z_30">
        <ImageView
            android:id="@+id/img_bind_way"
            android:layout_width="@dimen/dp_z_40"
            android:layout_height="@dimen/dp_z_66"
            android:layout_marginLeft="@dimen/dp_z_24"
            android:src="@drawable/cg_img_email"/>
        <EditText
            android:textSize="@dimen/sp_z_36"
            android:textColor="@color/cg_color_black"
            android:textColorHint="@color/cg_color_hint"
            android:id="@+id/edit_bind_email"
            android:background="@color/cg_color_white"
            android:paddingLeft="@dimen/dp_z_28"
            android:layout_width="@dimen/dp_z_750"
            android:layout_height="@dimen/dp_z_100"
            android:hint="@string/cg_txt_hint_input_email"
            android:singleLine="true"
            android:maxLength="50"
            android:imeOptions="flagNoExtractUi"/>
    </LinearLayout>
    <Button
        android:textColor="@color/cg_color_white"
        android:id="@+id/btn_confirm_bind"
        android:background="@drawable/cg_btn5"
        android:layout_width="@dimen/dp_z_834"
        android:layout_height="@dimen/dp_z_100"
        android:layout_marginTop="@dimen/dp_z_30"
        android:text="@string/cg_txt_confirm_submit"/>
</LinearLayout>
